# Generated by `expo prebuild`. Regenerated deterministically from
# app.json + plugins/, so it's safe to gitignore — but if you hand-edit
# android/ (per android-native-reference/README.md) and don't want to
# redo those edits after every prebuild, remove these two lines and
# commit the folders instead.
android/
ios/

npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
